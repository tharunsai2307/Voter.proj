# Replace with your real Polygon.io API key (never commit your actual key)
POLYGON_API_KEY=your_polygon_api_key_here

# Option to use the delayed feed (free/standard plans) or real-time feed
# wss://delayed.socket.polygon.io/stocks (Delayed - Free)
# wss://socket.polygon.io/stocks (Real-time - Paid)
POLYGON_WS_URL=wss://delayed.socket.polygon.io/stocks

# AI Analyst API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
